<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingBottom="4dp"
        android:textColor="#18212B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
    <TextView android:id="@+id/r6" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:textColor="#18212B" android:textSize="13sp" />
</LinearLayout>
